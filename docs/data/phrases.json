  {
    "group": "Ordering food & coffee",
    "kn": "ಒಂದು ಮಸಾಲೆ ದೋಸೆ",
    "translit": "Ondu masale dose",
    "say": "On-du ma-saa-le do-say",
    "meaning": "One masala dosa",
    "tip": "The most commonly mispronounced word on this whole list - it is \"do-say,\" not \"doh-sah.\" The final vowel is a clear, short \"eh,\" never silent."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಒಂದು ಕಾಫಿ",
    "translit": "Ondu kaapi",
    "say": "On-du kaa-pi",
    "meaning": "One coffee",
    "tip": "\"Kaapi,\" not \"coffee\" - the first vowel is long and drawn out. Order it this way at a darshini and it lands right."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಒಂದು ಇಡ್ಲಿ ವಡೆ",
    "translit": "Ondu idli vade",
    "say": "On-du id-li va-day",
    "meaning": "One idli-vada",
    "tip": "It is \"va-day\" in Kannada, not \"va-da\" - a small but telling difference if you have picked up the word elsewhere in India."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಸ್ವಲ್ಪ ಬೆಣ್ಣೆ ಹಾಕಿ",
    "translit": "Swalpa benne haaki",
    "say": "Swal-pa BEN-ne haa-ki",
    "meaning": "Please add a little butter",
    "tip": "\"Benne\" (butter) - the stress falls on the first syllable, BEN-ne, not ben-NE. Essential for ordering it right at a benne dosa counter."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಸ್ವಲ್ಪ ಖಾರ ಕಡಿಮೆ ಮಾಡಿ",
    "translit": "Swalpa khara kadime maadi",
    "say": "Swal-pa khaa-ra ka-di-me maa-di",
    "meaning": "Please make it less spicy",
    "tip": "\"Khara\" (spicy) often gets flattened to a plain \"kara\" - the \"kh\" wants a harder, breathier push, closer to gently clearing your throat."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಪಾರ್ಸೆಲ್ ಮಾಡಿ",
    "translit": "Parcel maadi",
    "say": "Paar-sel maa-di",
    "meaning": "Please pack it to go",
    "tip": "\"Parcel\" is the universal Bengaluru word for takeaway - not \"packet,\" not \"takeaway.\" Say this and nothing else is needed."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಇನ್ನೊಂದು ಪ್ಲೇಟ್",
    "translit": "Innondu plate",
    "say": "In-non-du plate",
    "meaning": "One more plate",
    "tip": "The line every darshini regular reaches for once the first round disappears."
  },
  {
    "group": "Ordering food & coffee",
    "kn": "ಬಿಲ್ ಕೊಡಿ",
    "translit": "Bill kodi",
    "say": "Bill ko-di",
    "meaning": "Please bring the bill",
    "tip": "Works everywhere, from a standing-only darshini to a sit-down restaurant."
  }
