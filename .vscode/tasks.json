{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview GitHub Pages",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/preview.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "pages-preview",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "^Preview:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
